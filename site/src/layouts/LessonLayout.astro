---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import ProgressTracker from '../components/ProgressTracker.astro';
import NoteEditor from '../components/NoteEditor.astro';

export interface Props {
  title: string;
  collection: string;
  contentId: string;
  items: { slug: string; title: string; order: number }[];
  currentSlug: string;
}

const { title, collection, contentId, items, currentSlug } = Astro.props;
const sortedItems = [...items].sort((a, b) => a.order - b.order);
const currentIndex = sortedItems.findIndex(i => i.slug === currentSlug);
const prev = currentIndex > 0 ? sortedItems[currentIndex - 1] : null;
const next = currentIndex < sortedItems.length - 1 ? sortedItems[currentIndex + 1] : null;
---

<BaseLayout title={title}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex gap-8">
      <aside class="hidden lg:block w-64 flex-shrink-0">
        <div class="sticky top-24">
          <Sidebar items={sortedItems} currentSlug={currentSlug} collection={collection} />
        </div>
      </aside>

      <div class="flex-1 min-w-0">
        <article class="prose prose-lg max-w-none
          prose-headings:font-serif prose-headings:text-boyo-800
          prose-h1:text-3xl prose-h1:border-b prose-h1:border-boyo-100 prose-h1:pb-3
          prose-h2:text-2xl prose-h2:mt-10 prose-h2:text-boyo-700
          prose-h3:text-xl prose-h3:text-boyo-700
          prose-p:text-bark-900 prose-p:leading-relaxed
          prose-a:text-boyo-500 prose-a:no-underline hover:prose-a:underline
          prose-strong:text-boyo-700
          prose-code:bg-boyo-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:text-accent-400 prose-code:before:content-none prose-code:after:content-none
          prose-pre:bg-boyo-900 prose-pre:text-boyo-100 prose-pre:rounded-xl prose-pre:shadow-lg
          prose-li:text-bark-900
          prose-blockquote:border-boyo-300 prose-blockquote:bg-boyo-50/50 prose-blockquote:rounded-r-lg prose-blockquote:py-2 prose-blockquote:px-4
          prose-table:border-boyo-200
          prose-th:bg-boyo-50 prose-th:text-boyo-700 prose-th:font-medium
          prose-td:border-boyo-100
          prose-img:rounded-xl prose-img:shadow-md
        ">
          <slot />
        </article>

        <div class="mt-8 pt-6 border-t border-boyo-100">
          <ProgressTracker contentId={contentId} />
        </div>

        <div class="mt-6">
          <NoteEditor contentId={contentId} />
        </div>

        <nav class="mt-10 flex items-center justify-between gap-4 pt-6 border-t border-boyo-100">
          {prev ? (
            <a href={`/${collection}/${prev.slug}`} class="flex items-center gap-2 text-sm text-boyo-600 hover:text-boyo-700 transition-colors group">
              <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
              <span class="line-clamp-1">{prev.title}</span>
            </a>
          ) : <div />}
          {next ? (
            <a href={`/${collection}/${next.slug}`} class="flex items-center gap-2 text-sm text-boyo-600 hover:text-boyo-700 transition-colors group text-right">
              <span class="line-clamp-1">{next.title}</span>
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          ) : <div />}
        </nav>
      </div>
    </div>
  </div>
</BaseLayout>
