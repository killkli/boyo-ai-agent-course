---
import Search from 'astro-pagefind/components/Search.astro';
---

<Search className="w-full" />

<style is:global>
  /* Pagefind theme overrides — match boyo design */
  pagefind-searchbox {
    --pf-text: #1a1a1a;
    --pf-text-secondary: #4a4a4a;
    --pf-text-muted: #767676;
    --pf-background: #fff;
    --pf-border: #d1f0e6;
    --pf-border-focus: #2D8B75;
    --pf-hover: #f0faf7;
    --pf-outline-focus: #2D8B75;
    --pf-outline-width: 2px;
    --pf-outline-offset: 2px;
    --pf-border-radius: 12px;
    --pf-input-height: 40px;
    --pf-input-font-size: 14px;
    --pf-searchbox-max-width: 100%;
    --pf-searchbox-dropdown-max-height: 320px;
    --pf-shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
    --pf-font: "Noto Sans TC", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --pf-mark: #2D8B75;
    --pf-dropdown-z-index: 9999;
  }
</style>
