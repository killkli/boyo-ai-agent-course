---
---

<div id="search" class="relative" style="display:none">
  <div class="relative">
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-bark-700/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      id="search-input"
      type="search"
      placeholder="搜尋課程內容..."
      class="w-full pl-10 pr-4 py-2.5 bg-white border border-boyo-200 rounded-xl text-sm text-bark-900 placeholder-bark-700/30 focus:outline-none focus:ring-2 focus:ring-boyo-300 focus:border-boyo-300"
    />
  </div>
  <div id="search-results" class="absolute top-full left-0 right-0 mt-2 bg-white rounded-xl border border-boyo-100 shadow-xl z-50 max-h-80 overflow-y-auto hidden">
  </div>
</div>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('search');
    if (el) el.style.display = '';

    if (typeof window.pagefind !== 'undefined') return;

    const s = document.createElement('script');
    s.src = '/pagefind/pagefind.js';
    s.onload = () => {
      const input = document.getElementById('search-input');
      const results = document.getElementById('search-results');
      if (!input || !results) return;

      input.addEventListener('input', async () => {
        const q = input.value.trim();
        if (!q) { results.classList.add('hidden'); return; }

        const search = await window.pagefind.search(q);
        const items = await Promise.all(search.results.slice(0, 8).map(r => r.data()));

        if (items.length === 0) {
          results.innerHTML = '<div class="p-4 text-sm text-bark-700/50 text-center">找不到相關內容</div>';
        } else {
          results.innerHTML = items.map(item => `
            <a href="${item.url}" class="block px-4 py-3 hover:bg-boyo-50 border-b border-boyo-50 last:border-0 transition-colors">
              <div class="text-sm font-medium text-boyo-700">${item.meta?.title || ''}</div>
              <div class="text-xs text-bark-700/60 mt-0.5 line-clamp-2">${item.excerpt || ''}</div>
            </a>
          `).join('');
        }
        results.classList.remove('hidden');
      });

      input.addEventListener('blur', () => {
        setTimeout(() => results.classList.add('hidden'), 200);
      });
    };
    document.head.appendChild(s);
  });
</script>
