---
export interface Props {
  items: { slug: string; title: string; order: number }[];
  currentSlug: string;
  collection: string;
}

const { items, currentSlug, collection } = Astro.props;
---

<nav class="space-y-1">
  <h3 class="text-xs font-semibold text-bark-700/50 uppercase tracking-wider mb-3 px-3">
    {collection === 'lessons' ? '課程章節' : collection === 'labs' ? '實作 Lab' : '章節目錄'}
  </h3>
  {items.map((item, i) => (
    <a
      href={`/${collection}/${item.slug}`}
      class:list={[
        'flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-all',
        item.slug === currentSlug
          ? 'bg-boyo-500 text-white font-medium shadow-sm'
          : 'text-bark-700 hover:bg-boyo-50 hover:text-boyo-700',
      ]}
    >
      <span class:list={[
        'w-6 h-6 rounded-full flex items-center justify-center text-xs font-medium flex-shrink-0',
        item.slug === currentSlug
          ? 'bg-white/20 text-white'
          : 'bg-boyo-100 text-boyo-600',
      ]}>
        {i + 1}
      </span>
      <span class="line-clamp-2">{item.title}</span>
    </a>
  ))}
</nav>
