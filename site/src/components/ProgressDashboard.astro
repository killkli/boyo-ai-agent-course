---
---

<div id="progress-dashboard" class="space-y-6">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl border border-boyo-100 p-5 text-center">
      <div id="stat-none" class="text-3xl font-serif font-bold text-gray-300">-</div>
      <div class="text-sm text-bark-700/60 mt-1">尚未開始</div>
    </div>
    <div class="bg-white rounded-xl border border-accent-200 p-5 text-center">
      <div id="stat-progress" class="text-3xl font-serif font-bold text-accent-400">-</div>
      <div class="text-sm text-bark-700/60 mt-1">學習中</div>
    </div>
    <div class="bg-white rounded-xl border border-boyo-200 p-5 text-center">
      <div id="stat-done" class="text-3xl font-serif font-bold text-boyo-500">-</div>
      <div class="text-sm text-bark-700/60 mt-1">已完成</div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-boyo-100 p-5">
    <h3 class="font-serif font-semibold text-boyo-700 mb-3">整體進度</h3>
    <div class="w-full bg-boyo-100 rounded-full h-4 overflow-hidden">
      <div id="progress-bar" class="bg-boyo-500 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
    </div>
    <div class="flex items-center justify-between mt-2">
      <span id="progress-text" class="text-sm text-bark-700/60">載入中...</span>
      <div class="flex gap-2">
        <button id="export-btn" class="text-xs px-3 py-1.5 rounded-lg bg-boyo-50 text-boyo-600 hover:bg-boyo-100 transition-colors">匯出備份</button>
        <label class="text-xs px-3 py-1.5 rounded-lg bg-boyo-50 text-boyo-600 hover:bg-boyo-100 transition-colors cursor-pointer">
          匯入還原
          <input id="import-input" type="file" accept=".json" class="hidden" />
        </label>
      </div>
    </div>
  </div>

  <div id="notes-list" class="bg-white rounded-xl border border-boyo-100 p-5">
    <h3 class="font-serif font-semibold text-boyo-700 mb-3">我的筆記</h3>
    <div id="notes-items" class="space-y-2">
      <p class="text-sm text-bark-700/40">載入中...</p>
    </div>
  </div>
</div>

<script>
  async function openDB() {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open('boyo-agent-tutor', 1);
      req.onupgradeneeded = (e) => {
        const db = e.target.result;
        if (!db.objectStoreNames.contains('progress')) db.createObjectStore('progress', { keyPath: 'id' });
        if (!db.objectStoreNames.contains('notes')) db.createObjectStore('notes', { keyPath: 'id' });
      };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }

  function getAll(store) {
    return async () => {
      const db = await openDB();
      return new Promise((resolve) => {
        const r = db.transaction(store, 'readonly').objectStore(store).getAll();
        r.onsuccess = () => resolve(r.result);
      });
    };
  }

  async function render() {
    const progressList = await getAll('progress')();
    const notesList = await getAll('notes')();

    const total = 29;
    const counts = { none: 0, 'in-progress': 0, done: 0 };
    for (const item of progressList) {
      if (counts[item.status] !== undefined) counts[item.status]++;
    }
    const unanswered = total - progressList.length;
    counts.none += unanswered;

    document.getElementById('stat-none').textContent = counts.none;
    document.getElementById('stat-progress').textContent = counts['in-progress'];
    document.getElementById('stat-done').textContent = counts.done;

    const pct = Math.round((counts.done / total) * 100);
    document.getElementById('progress-bar').style.width = pct + '%';
    document.getElementById('progress-text').textContent = `已完成 ${counts.done} / ${total} 個單元（${pct}%）`;

    const notesItems = document.getElementById('notes-items');
    const notesWithContent = notesList.filter(n => n.content && n.content.trim());
    if (notesWithContent.length === 0) {
      notesItems.innerHTML = '<p class="text-sm text-bark-700/40">還沒有筆記，開始學習後可以在此記錄心得。</p>';
    } else {
      notesItems.innerHTML = notesWithContent.map(n => `
        <div class="flex items-start gap-3 p-3 rounded-lg bg-cream-50 border border-boyo-50">
          <div class="flex-1 min-w-0">
            <div class="text-xs text-bark-700/40 mb-1">${n.id}</div>
            <p class="text-sm text-bark-900 line-clamp-3">${n.content.replace(/</g, '&lt;')}</p>
          </div>
        </div>
      `).join('');
    }
  }

  document.getElementById('export-btn')?.addEventListener('click', async () => {
    const progressList = await getAll('progress')();
    const notesList = await getAll('notes')();
    const data = { progress: Object.fromEntries(progressList.map(p => [p.id, p])), notes: Object.fromEntries(notesList.map(n => [n.id, n])), exportedAt: new Date().toISOString() };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `boyo-agent-tutor-backup-${new Date().toISOString().slice(0,10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('import-input')?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const text = await file.text();
    const data = JSON.parse(text);
    const db = await openDB();
    const tx = db.transaction(['progress', 'notes'], 'readwrite');
    for (const item of Object.values(data.progress || {})) tx.objectStore('progress').put(item);
    for (const item of Object.values(data.notes || {})) tx.objectStore('notes').put(item);
    await new Promise(r => { tx.oncomplete = r; });
    render();
  });

  render();
</script>
