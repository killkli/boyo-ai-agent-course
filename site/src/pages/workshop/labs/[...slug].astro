---
import { getCollection } from 'astro:content';
import LessonLayout from '../../../layouts/LessonLayout.astro';

export async function getStaticPaths() {
  const labs = await getCollection('labs');
  return labs.map((lab) => ({
    params: { slug: lab.slug },
    props: { lab },
  }));
}

const { lab } = Astro.props;
const { Content } = await lab.render();
const allLabs = (await getCollection('labs')).sort((a, b) => a.data.order - b.data.order);
const items = allLabs.map(l => ({ slug: l.slug, title: l.data.title, order: l.data.order }));
---

<LessonLayout
  title={lab.data.title}
  collection="labs"
  contentId={`lab-${lab.slug}`}
  items={items}
  currentSlug={lab.slug}
>
  <Content />
</LessonLayout>
