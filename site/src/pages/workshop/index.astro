---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs')).sort((a, b) => a.data.order - b.data.order);
const handouts = (await getCollection('handouts')).sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const teachingNotes = (await getCollection('teaching-notes')).sort((a, b) => a.data.order - b.data.order);
const templates = (await getCollection('templates')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="全天工作坊" description="AI Agent 全天實作工作坊 — 6 小時從安裝到打造辦公室場景 Agent">
  <div class="bg-gradient-to-br from-accent-50 to-cream-50 border-b border-accent-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-100 text-accent-500 text-sm font-medium mb-4">
          全天實作工作坊
        </div>
        <h1 class="font-serif font-bold text-3xl sm:text-4xl text-boyo-800">
          AI Agent 教學工作坊
        </h1>
        <p class="mt-4 text-bark-700/70 leading-relaxed">
          6 小時的密集實作課程，從安裝 Hermes 開始，一步步把 Agent 放進博幼基金會的教材製作、教學輔導與幕僚協作工作流。這裡整理了 Lab、講義、教學指引與可直接帶回去套用的模板。
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="font-serif font-bold text-2xl text-boyo-800 mb-6">實作單元</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {labs.map((lab, i) => (
        <Card
          href={`${base}/workshop/labs/${lab.slug}`}
          title={lab.data.title}
          description={lab.data.description}
          order={i + 1}
          tag={`Lab ${i + 1} · ${lab.data.duration}`}
          tagColor="accent"
        />
      ))}
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="font-serif font-bold text-2xl text-boyo-800 mb-6">工作坊講義</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {handouts.map((h) => (
        <Card
          href={`${base}/workshop/handouts/${h.slug}`}
          title={h.data.title}
          description={h.data.description}
          tag="講義"
          tagColor="boyo"
        />
      ))}
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="font-serif font-bold text-2xl text-boyo-800 mb-6">工作坊指南</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {guides.map((guide) => (
        <Card
          href={`${base}/workshop/guides/${guide.slug}`}
          title={guide.data.title}
          description={guide.data.description}
          tag="指南"
          tagColor="accent"
        />
      ))}
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="font-serif font-bold text-2xl text-boyo-800 mb-6">講師教學指引</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {teachingNotes.map((note) => (
        <Card
          href={`${base}/workshop/teaching-notes/${note.slug}`}
          title={note.data.title}
          description={note.data.description}
          tag="教學指引"
          tagColor="boyo"
        />
      ))}
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="font-serif font-bold text-2xl text-boyo-800 mb-6">工作流模板</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {templates.map((template) => (
        <Card
          href={`${base}/workshop/templates/${template.slug}`}
          title={template.data.title}
          description={template.data.description}
          tag="模板"
          tagColor="accent"
        />
      ))}
    </div>
  </div>
</BaseLayout>
